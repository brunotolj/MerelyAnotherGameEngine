
Assets
{
	BoxMesh:StaticMesh { type=Box halfX=20 halfY=20 halfZ=1 }
	CylinderMesh:StaticMesh { type=Cylinder radius=4 halfHeight=3 }
	CapsuleMesh:StaticMesh { type=Capsule radius=2 halfHeight=1.5 }
	BallMesh:StaticMesh { type=Sphere radius=1 }
	
	BoardCollision:PhysicsShape { type=Box halfX=20 halfY=20 halfZ=1 }
	CornerCollision:PhysicsShape { type=Cylinder radius=4 halfHeight=3 }
	CapsuleCollision:PhysicsShape { type=Capsule radius=2 halfHeight=1.5 }
	BallCollision:PhysicsShape { type=Sphere radius=1 }
	
	DefaultMaterial:PhysicsMaterial { staticFriction=0.2 dynamicFriction=0.1 restitution=1.0 }
	FloorMaterial:PhysicsMaterial { staticFriction=0.2 dynamicFriction=0.05 restitution=0.0 }
	BallMaterial:PhysicsMaterial { staticFriction=0.2 dynamicFriction=0.1 restitution=0.8 }
}

Components
{
	TransformTree
	Renderer
	FreeMoveSystem { speed=10 }
	GameplaySystem { halfSpan=10 maxSpeed=80 acceleration=80 deceleration=150 ballSpawnInterval=2 ballPhysicsShape=Worlds/TestWorld.mage:BallCollision ballPhysicsMaterial=Worlds/TestWorld.mage:BallMaterial ballMesh=Worlds/TestWorld.mage:BallMesh ballTexture=Textures/ball.png }
	PhysicsSystem
	WorldBoundsSystem { bounds.Min.X=-10000 bounds.Max.X=10000 bounds.Min.Y=-10000 bounds.Max.Y=10000 bounds.Min.Z=-10 bounds.Max.Z=10000 }
	MeshRenderSystem
	SpriteRenderSystem
	TextRenderSystem
}

Entities
{
	SpriteEntity { screenCoords.Min.X=50 screenCoords.Min.Y=50 screenCoords.Max.X=150 screenCoords.Max.Y=150 texture=Textures/default.png }
	TextEntity { text="Merely Another Game Engine" color.R=1.0 color.G=0.5 color.B=0.0 position.X=180 position.Y=90 scale=40 font=Fonts/ArianaVioleta-dz2K.ttf }
	TextEntity { text=M.A.G.E color.R=0.5 color.G=1.0 color.B=1.0 position.X=180 position.Y=140 scale=40 font=Fonts/Orbitron-Regular.ttf }

	TransformEntity { position.Y=-30 position.Z=10 }
	> FreeMoveTargetEntity
	> CameraEntity

	TransformEntity { }
	> StaticRigidBodyEntity { shape=Worlds/TestWorld.mage:BoardCollision material=Worlds/TestWorld.mage:FloorMaterial }
	> StaticMeshEntity { mesh=Worlds/TestWorld.mage:BoxMesh texture=Textures/cube.png }

	TransformEntity { position.X=16 position.Y=16 position.Z=3 rotationAxis.Y=1 rotationAngle=90 }
	> StaticRigidBodyEntity { shape=Worlds/TestWorld.mage:CornerCollision material=Worlds/TestWorld.mage:DefaultMaterial }
	> StaticMeshEntity { mesh=Worlds/TestWorld.mage:CylinderMesh texture=Textures/cylinder.png }
	> TransformEntity { position.X=16 position.Y=16 position.Z=8 rotationAxis.Z=1 rotationAngle=135 }
	>> BallSpawnerEntity { velocity.X=12 variance.X=2 variance.Y=5 }

	TransformEntity { position.X=-16 position.Y=16 position.Z=3 rotationAxis.Y=1 rotationAngle=90 }
	> StaticRigidBodyEntity { shape=Worlds/TestWorld.mage:CornerCollision material=Worlds/TestWorld.mage:DefaultMaterial }
	> StaticMeshEntity { mesh=Worlds/TestWorld.mage:CylinderMesh texture=Textures/cylinder.png }
