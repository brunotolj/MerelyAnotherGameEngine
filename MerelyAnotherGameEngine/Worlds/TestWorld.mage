
Assets
{
	BoxMesh=StaticMesh:Box { HalfExtent.x=20 HalfExtent.y=20 HalfExtent.z=1 }
	CylinderMesh=StaticMesh:Cylinder { Radius=4 HalfHeight=3 }
	CapsuleMesh=StaticMesh:Capsule { Radius=2 HalfHeight=1.5 }
	BallMesh=StaticMesh:Sphere { Radius=1 }
	
	BoardCollision=PhysicsShape:Box { HalfExtent.x=20 HalfExtent.y=20 HalfExtent.z=1 }
	CornerCollision=PhysicsShape:Cylinder { Radius=4 HalfHeight=3 }
	CapsuleCollision=PhysicsShape:Capsule { Radius=2 HalfHeight=1.5 }
	BallCollision=PhysicsShape:Sphere { Radius=1 }
	
	DefaultMaterial=PhysicsMaterial { StaticFriction=0.2 DynamicFriction=0.1 Restitution=1.0 }
	FloorMaterial=PhysicsMaterial { StaticFriction=0.2 DynamicFriction=0.05 Restitution=0.0 }
	BallMaterial=PhysicsMaterial { StaticFriction=0.2 DynamicFriction=0.1 Restitution=0.8 }
}

Components
{
	TransformTree
	Renderer
	FreeMoveSystem { Speed=10 }
	GameplaySystem { HalfSpan=10 MaxSpeed=80 Acceleration=80 Deceleration=150 BallSpawnInterval=2 BallPhysicsShape=:BallCollision BallPhysicsMaterial=:BallMaterial BallMesh=:BallMesh BallTexture=Textures/ball.png }
	PhysicsSystem
	WorldBoundsSystem { BoundsMin.x=-10000 BoundsMax.x=10000 BoundsMin.y=-10000 BoundsMax.y=10000 BoundsMin.z=-10 BoundsMax.z=10000 }
	MeshRenderSystem
	SpriteRenderSystem
	TextRenderSystem
}

Entities
{
	SpriteEntity { ScreenCoordsMin.x=50 ScreenCoordsMin.y=50 ScreenCoordsMax.x=150 ScreenCoordsMax.y=150 Texture=Textures/default.png }
	TextEntity { Text="Merely Another Game Engine" Color.r=1.0 Color.g=0.5 Color.b=0.0 ScreenPosition.x=180 ScreenPosition.y=90 Scale=40 Font=Fonts/ArianaVioleta-dz2K.ttf }
	TextEntity { Text=M.A.G.E Color.r=0.5 Color.g=1.0 Color.b=1.0 ScreenPosition.x=180 ScreenPosition.y=140 Scale=40 Font=Fonts/Orbitron-Regular.ttf }

	TransformEntity { Position.y=-30 Position.z=10 }
	> FreeMoveTargetEntity
	> CameraEntity

	TransformEntity { }
	> StaticRigidBodyEntity { Shape=:BoardCollision Material=:FloorMaterial }
	> StaticMeshEntity { Mesh=:BoxMesh Texture=Textures/cube.png }

	TransformEntity { Position.x=16 Position.y=16 Position.z=3 RotationAxis.y=1 RotationAngle=90 }
	> StaticRigidBodyEntity { Shape=:CornerCollision Material=:DefaultMaterial }
	> StaticMeshEntity { Mesh=:CylinderMesh Texture=Textures/cylinder.png }
	> TransformEntity { Position.x=16 Position.y=16 Position.z=8 RotationAxis.z=1 RotationAngle=135 }
	>> BallSpawnerEntity { Velocity.x=12 Variance.x=2 Variance.y=5 }

	TransformEntity { Position.x=-16 Position.y=16 Position.z=3 RotationAxis.y=1 RotationAngle=90 }
	> StaticRigidBodyEntity { Shape=:CornerCollision Material=:DefaultMaterial }
	> StaticMeshEntity { Mesh=:CylinderMesh Texture=Textures/cylinder.png }
	> TransformEntity { Position.x=-16 Position.y=16 Position.z=8 RotationAxis.z=1 RotationAngle=45 }
	>> BallSpawnerEntity { Velocity.x=12 Variance.x=2 Variance.y=5 }

	TransformEntity { Position.x=-16 Position.y=-16 Position.z=3 RotationAxis.y=1 RotationAngle=90 }
	> StaticRigidBodyEntity { Shape=:CornerCollision Material=:DefaultMaterial }
	> StaticMeshEntity { Mesh=:CylinderMesh Texture=Textures/cylinder.png }
	> TransformEntity { Position.x=-16 Position.y=-16 Position.z=8 RotationAxis.z=1 RotationAngle=-45 }
	>> BallSpawnerEntity { Velocity.x=12 Variance.x=2 Variance.y=5 }

	TransformEntity { Position.x=16 Position.y=-16 Position.z=3 RotationAxis.y=1 RotationAngle=90 }
	> StaticRigidBodyEntity { Shape=:CornerCollision Material=:DefaultMaterial }
	> StaticMeshEntity { Mesh=:CylinderMesh Texture=Textures/cylinder.png }
	> TransformEntity { Position.x=16 Position.y=-16 Position.z=8 RotationAxis.z=1 RotationAngle=-135 }
	>> BallSpawnerEntity { Velocity.x=12 Variance.x=2 Variance.y=5 }

	TransformEntity { Position.x=-20 Position.z=2 }
	> DynamicRigidBodyEntity { Shape=:CapsuleCollision Material=:DefaultMaterial IsKinematic=1 }
	> StaticMeshEntity { Mesh=:CapsuleMesh Texture=Textures/capsule.png }
	> CapsuleMoverEntity { InputCodeNegative=72 InputCodePositive=74 }

	TransformEntity { Position.y=20 Position.z=2 RotationAxis.z=1 RotationAngle=90 }
	> DynamicRigidBodyEntity { Shape=:CapsuleCollision Material=:DefaultMaterial IsKinematic=1 }
	> StaticMeshEntity { Mesh=:CapsuleMesh Texture=Textures/capsule.png }
	> CapsuleMoverEntity { InputCodeNegative=85 InputCodePositive=73 }

	TransformEntity { Position.x=20 Position.z=2 RotationAxis.z=1 RotationAngle=180 }
	> DynamicRigidBodyEntity { Shape=:CapsuleCollision Material=:DefaultMaterial IsKinematic=1 }
	> StaticMeshEntity { Mesh=:CapsuleMesh Texture=Textures/capsule.png }
	> CapsuleMoverEntity { InputCodeNegative=79 InputCodePositive=80 }

	TransformEntity { Position.y=-20 Position.z=2 RotationAxis.z=1 RotationAngle=-90 }
	> DynamicRigidBodyEntity { Shape=:CapsuleCollision Material=:DefaultMaterial IsKinematic=1 }
	> StaticMeshEntity { Mesh=:CapsuleMesh Texture=Textures/capsule.png }
	> CapsuleMoverEntity { InputCodeNegative=75 InputCodePositive=76 }
}
